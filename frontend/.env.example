# 프론트엔드 환경변수 템플릿
# 이 파일을 .env 로 복사한 뒤 본인 키로 채워주세요.
# .env 는 .gitignore 되어 push되지 않습니다.

# API base URL
# - 로컬 Vite proxy를 쓰면 빈 값으로 둘 수 있습니다.
# - 배포 환경에선 백엔드 URL 지정: VITE_API_BASE_URL=https://api.triplan.example.com
VITE_API_BASE_URL=http://localhost:8080

# 카카오 JavaScript 키 (카카오맵 + 카카오 공유)
# https://developers.kakao.com → 앱 > 플랫폼 > Web 에서 발급
VITE_KAKAO_JAVASCRIPT_KEY=your-kakao-javascript-key
